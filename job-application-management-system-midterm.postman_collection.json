    {
      "name": "D1 - Safe saving (past date - 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicationDate\": \"2020-01-15\",\n  \"status\": \"SUBMITTED\",\n  \"jobTitle\": \"Developer\",\n  \"cvFileName\": \"cv.pdf\",\n  \"applicant\": {\n    \"id\": \"{{applicantId}}\"\n  },\n  \"recruiter\": {\n    \"id\": \"{{recruiterId}}\"\n  }\n}"
        },
        "url": "{{baseUrl}}/api/job-applications/save"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "D1 - Safe saving (duplicate date - 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicationDate\": \"{{conflictDate}}\",\n  \"status\": \"SCREENED\",\n  \"jobTitle\": \"Another Job\",\n  \"cvFileName\": \"cv2.pdf\",\n  \"applicant\": {\n    \"id\": \"{{applicantId}}\"\n  },\n  \"recruiter\": {\n    \"id\": \"{{conflictRecruiterId}}\"\n  }\n}"
        },
        "url": "{{baseUrl}}/api/job-applications/save"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// use a real recruiter + date that already has an application that is not REJECTED",
              "const url = pm.variables.replaceIn('{{baseUrl}}') + '/api/job-applications/all';",
              "pm.sendRequest(url, (err, res) => {",
              "  const today = new Date().toISOString().slice(0, 10);",
              "  const row = res.json().find(a => a.status !== 'REJECTED' && a.applicationDate >= today && a.recruiter);",
              "  if (row) {",
              "    pm.collectionVariables.set('conflictDate', row.applicationDate);",
              "    pm.collectionVariables.set('conflictRecruiterId', row.recruiter.id);",
              "  }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
