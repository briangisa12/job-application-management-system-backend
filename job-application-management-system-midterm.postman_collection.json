    {
      "name": "A2 - Job Applications CRUD",
      "item": [
        {
          "name": "A2 - Save JobApplication",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationDate\": \"{{freeDate}}\",\n  \"status\": \"SUBMITTED\",\n  \"jobTitle\": \"Junior Developer\",\n  \"cvFileName\": \"brian_cv.pdf\",\n  \"applicant\": {\n    \"id\": \"{{applicantId}}\"\n  },\n  \"recruiter\": {\n    \"id\": \"{{recruiterId}}\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/job-applications/save"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// a future date the recruiter is very unlikely to have yet",
                  "const d = new Date();",
                  "d.setDate(d.getDate() + 365 + Math.floor(Math.random() * 3000));",
                  "pm.collectionVariables.set('freeDate', d.toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 - Get All JobApplications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/job-applications/all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json();",
                  "if (rows.length > 0) {",
                  "  pm.collectionVariables.set('jobApplicationId', rows[0].id);",
                  "  const submitted = rows.find(r => r.status === 'SUBMITTED');",
                  "  const shortlisted = rows.find(r => r.status === 'SHORTLISTED');",
                  "  if (submitted) pm.collectionVariables.set('submittedApplicationId', submitted.id);",
                  "  if (shortlisted) pm.collectionVariables.set('shortlistedApplicationId', shortlisted.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 - Get JobApplication By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/job-applications/{{jobApplicationId}}"
